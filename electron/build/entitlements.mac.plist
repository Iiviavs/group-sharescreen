<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Hardened runtime is on (see electron-builder.yml), which turns every
         capability below into something that must be declared or is simply
         denied at runtime with no dialog and no error the app can catch. -->

    <!-- Electron's renderer and V8 need both of these under hardened
         runtime; without them the app fails to launch at all on a signed
         build, which is a confusing way to find out. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Server, not just client: WebRTC listens on local UDP sockets for
         incoming peer traffic, and a mesh call is exactly the case where
         the other side connects to us. -->
    <key>com.apple.security.network.server</key>
    <true/>
  </dict>
</plist>
