{
  "uid": "sharescreen-overview",
  "title": "ShareScreen",
  "tags": ["sharescreen"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sockets conectados",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sharescreen_connected_sockets", "legendFormat": "sockets", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }] } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Peers registrados",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sharescreen_registered_peers", "legendFormat": "peers", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }] } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Salas públicas ativas",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sharescreen_rooms{visibility=\"public\"}", "legendFormat": "públicas", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }] } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Salas privadas ativas",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sharescreen_rooms{visibility=\"private\"}", "legendFormat": "privadas", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }] } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Uso de CPU (%)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total[1m]) * 100", "legendFormat": "CPU %", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memória",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "RSS", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "nodejs_heap_size_used_bytes", "legendFormat": "Heap usado", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "nodejs_heap_size_total_bytes", "legendFormat": "Heap total", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latência do event loop",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "p99", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "nodejs_eventloop_lag_mean_seconds", "legendFormat": "média", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Conexões mortas reaproveitadas pelo heartbeat",
      "description": "Sockets derrubados por não responderem ao ping (queda de rede sem fechamento limpo) — indicador de qualidade de conexão dos usuários.",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(sharescreen_heartbeat_reaped_total[5m])", "legendFormat": "reaped/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Conexões WebSocket (taxa)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(sharescreen_ws_connections_total[5m])", "legendFormat": "conexões/s", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "rate(sharescreen_ws_disconnections_total[5m])", "legendFormat": "desconexões/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Erros de registro (nome inválido/em uso)",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(sharescreen_register_errors_total[5m])", "legendFormat": "erros/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Sinalização WebRTC retransmitida",
      "description": "Ofertas/respostas/candidatos ICE repassados pelo servidor de sinalização, por tipo.",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (kind) (rate(sharescreen_signals_relayed_total[5m]))", "legendFormat": "{{kind}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Salas criadas (taxa)",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (visibility) (rate(sharescreen_rooms_created_total[15m]))", "legendFormat": "{{visibility}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Top salas públicas por pessoas conectadas",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(10, sharescreen_room_people)",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "room": "Sala", "Value": "Pessoas" } } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Salas privadas — total de pessoas e maiores (anônimo)",
      "description": "Tamanhos das maiores salas privadas por posição (rank), sem nunca expor qual sala é — só o servidor sabe disso.",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sharescreen_private_rooms_people_total", "legendFormat": "total em salas privadas", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "sharescreen_private_room_top_people", "legendFormat": "rank {{rank}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
